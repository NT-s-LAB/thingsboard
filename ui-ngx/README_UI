## 🔐 SECURITY

### **Authentication**

**JWT Token:**
```typescript
// Stored in localStorage
localStorage.setItem('jwt_token', token);

// Attached to requests via interceptor
@Injectable()
export class AuthInterceptor implements HttpInterceptor {
  intercept(req: HttpRequest<any>, next: HttpHandler) {
    const token = localStorage.getItem('jwt_token');
    if (token) {
      req = req.clone({
        setHeaders: { Authorization: `Bearer ${token}` }
      });
    }
    return next.handle(req);
  }
}
```

### **Route Guards**

```typescript
@Injectable()
export class AuthGuard implements CanActivate {
  canActivate(route: ActivatedRouteSnapshot): boolean {
    const requiredAuth = route.data.auth;
    const userAuthority = this.store.selectSnapshot(selectUserAuthority);
    
    return userAuthority.includes(requiredAuth);
  }
}
```

### **XSS Protection**

- Angular sanitizes HTML by default
- Use `DomSanitizer` carefully
- Avoid `innerHTML` with user input

### **CSRF Protection**

- Backend handles CSRF tokens
- Frontend includes token in headers

