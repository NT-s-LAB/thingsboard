## 📝 BEST PRACTICES

### **Code Style**

**ESLint Config:** `eslint.config.mjs`
```javascript
// Extends:
- @angular-eslint/recommended
- eslint:recommended
- plugin:@typescript-eslint/recommended
```

**TypeScript Strict Mode:**
```json
{
  "strict": true,
  "noImplicitAny": true,
  "strictNullChecks": true
}
```

### **Component Guidelines**

**1. Single Responsibility:**
```typescript
// ✅ Good
@Component({...})
export class DeviceListComponent {}

@Component({...})
export class DeviceDetailsComponent {}

// ❌ Bad
@Component({...})
export class DeviceComponent {} // Does everything
```

**2. Smart vs Dumb Components:**
```typescript
// Smart (Container)
@Component({
  template: '<app-device-list [devices]="devices$ | async">'
})
export class DevicePageComponent {
  devices$ = this.store.select(selectDevices);
}

// Dumb (Presentational)
@Component({...})
export class DeviceListComponent {
  @Input() devices: Device[];
  @Output() deviceClick = new EventEmitter();
}
```

**3. Use RxJS Operators:**
```typescript
// ✅ Good
this.http.get('/api/devices').pipe(
  map(response => response.data),
  catchError(error => of([])),
  shareReplay(1)
);

// ❌ Bad
this.http.get('/api/devices').subscribe(...)
```

### **State Management**

**1. Immutable Updates:**
```typescript
// ✅ Good
case UPDATE_DEVICE:
  return {
    ...state,
    devices: state.devices.map(d =>
      d.id === action.device.id ? action.device : d
    )
  };

// ❌ Bad
case UPDATE_DEVICE:
  state.devices[index] = action.device;
  return state;
```

**2. Selector Composition:**
```typescript
export const selectDeviceState = (state: AppState) => state.devices;
export const selectAllDevices = createSelector(
  selectDeviceState,
  state => state.entities
);
export const selectActiveDevices = createSelector(
  selectAllDevices,
  devices => devices.filter(d => d.active)
);
```

