# Environment variables for EITEK Platform Backend
# Copy file này thành .env (dev) hoặc đặt lên VPS (prod)
# File này được commit lên git để tham khảo cấu trúc

# ================================
# DATABASE CONFIGURATION  
# ================================
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/eitek_platform?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=USERNAME
DB_PASSWORD=PASSWORD
DB_NAME=eitek_platform

# ================================
# APPLICATION CONFIGURATION
# ================================
# Dev: development | Prod: production
NODE_ENV=development
PORT=3001
APP_NAME="EITEK Platform"
APP_VERSION="1.0.0"

# ================================
# JWT & AUTHENTICATION
# ================================
# PRODUCTION: Dùng chuỗi ngẫu nhiên 64+ ký tự
# Tạo bằng: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_ACCESS_EXPIRATION="1d"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_REFRESH_EXPIRATION="7d"

# ================================
# FRONTEND & CORS CONFIGURATION
# ================================
# URL của frontend (dùng cho CORS & email activation link)
# Dev:  http://localhost:3000
# Prod: https://yourdomain.com
FRONTEND_URL="http://localhost:3000"

# Thêm nhiều origins cách nhau bằng dấu phẩy (tùy chọn)
# Prod ví dụ: https://yourdomain.com,https://www.yourdomain.com
# CORS_ORIGINS="https://yourdomain.com"

# ================================
# THINGSBOARD INTEGRATION
# ================================
THINGSBOARD_URL="http://platform.eitek.vn"
THINGSBOARD_USERNAME="admin@eitek.com"
THINGSBOARD_PASSWORD="THINGSBOARD_PASSWORD_HERE"
THINGSBOARD_TIMEOUT=30000
THINGSBOARD_RETRY_ATTEMPTS=3
THINGSBOARD_RETRY_DELAY=1000

# ================================
# SECURITY
# ================================
BCRYPT_SALT_ROUNDS=12

# ================================
# REDIS (Bắt buộc — backend crash nếu không có Redis)
# ================================
# Cài Redis: sudo apt install redis-server (Ubuntu/Debian)
# Hoặc dùng Redis Cloud: https://redis.io/try-free/
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# SCALABILITY CONFIGURATION
# ================================
ENABLE_GLOBAL_DEVICE_POLLING=false

# ================================
# FILE STORAGE
# ================================
FILE_STORAGE_PATH="./uploads"
MAX_FILE_SIZE=10485760

# ================================
# LOGGING
# ================================
# Dev: debug | Prod: warn
LOG_LEVEL=debug
LOG_FILE_PATH="./logs"