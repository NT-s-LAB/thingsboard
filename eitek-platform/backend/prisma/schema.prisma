// EITEK Platform - Prisma Schema
// Single consistent schema for the entire application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// ENUMS
// ================================

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  PROJECT_MANAGER
  OPERATOR
  VIEWER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum WidgetType {
  GAUGE
  CHART
  TABLE
  MAP
  BUTTON
  INPUT
  DISPLAY
  ALARM
  IMAGE
  CUSTOM
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
  ARCHIVE
  WIDGET
  TEMPLATE
  SYMBOL
  SCRIPT
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SYNC
}

enum AddonType {
  QUOTA    // thêm số lượng (devices, users, projects...)
  FEATURE  // unlock tính năng (SCADA Editor, White-label...)
}

enum AddonResourceType {
  DEVICES
  USERS
  PROJECTS
  DASHBOARDS
  API_CALLS
  STORAGE
}

// ================================
// TENANT PROFILES
// ================================

model TenantProfile {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  maxUsers      Int      @default(10)
  maxDevices    Int      @default(100)
  maxProjects   Int      @default(5)
  maxDashboards Int      @default(10)
  maxApiCalls   Int?     // null = unlimited
  features      String[] @default([])
  addonEligible Boolean  @default(false) // Starter = false → force upgrade
  price         Float    @default(0)     // 0 = free
  isCommercial  Boolean  @default(false) // true = visible in tenant add-on store
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants Tenant[]

  @@map("tenant_profiles")
}

// ================================
// ADDON SYSTEM
// ================================

model AddonCatalog {
  id              String            @id @default(uuid())
  code            String            @unique // e.g. "EXTRA_DEVICES_50", "SCADA_EDITOR"
  name            String            // e.g. "Extra 50 Devices"
  description     String?
  type            AddonType         // QUOTA or FEATURE
  resourceType    AddonResourceType? // only for QUOTA addons
  quantityPerUnit Int?              // e.g. 50 (devices), 10 (users) — null for FEATURE
  featureFlag     String?           // e.g. "scada_editor" — only for FEATURE addons
  priceMonthly    Float             @default(0)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenantAddons TenantAddon[]

  @@map("addon_catalog")
}

model TenantAddon {
  id        String   @id @default(uuid())
  tenantId  String
  addonId   String
  quantity  Int      @default(1)   // how many units purchased (1 unit = quantityPerUnit resources)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addon  AddonCatalog @relation(fields: [addonId], references: [id])

  @@unique([tenantId, addonId]) // one entry per tenant-addon pair, quantity controls amount
  @@map("tenant_addons")
}

// ================================
// AUTHENTICATION & AUTHORIZATION
// ================================

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  settings    Json?
  isActive    Boolean  @default(true)
  tbTenantId  String?
  tbSettings  Json?
  profileId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile   TenantProfile? @relation(fields: [profileId], references: [id])
  users     User[]
  projects  Project[]
  auditLogs AuditLog[]
  addons    TenantAddon[]
  notifications              Notification[]
  deviceScadaTemplates      DeviceScadaTemplate[]
  deviceProfileScadaDefaults DeviceProfileScadaDefault[]
  tenantDeviceProfiles       TenantDeviceProfile[]
  tenantAssetProfiles        TenantAssetProfile[]

  @@map("tenants")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  firstName           String
  lastName            String
  password            String
  avatar              String?
  phone               String?
  description         String?
  role                UserRole  @default(VIEWER)
  isActive            Boolean   @default(true)
  lastLogin           DateTime?
  tbUserId            String?
  tbToken             String?
  activationToken     String?   @unique
  activationExpiresAt DateTime?
  isActivated         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  userRoles    UserRoleMapping[]
  userProjects UserProject[]
  fileUploads  File[]              @relation("FileUploader")
  auditLogs    AuditLog[]
  notifications Notification[]
  settings     UserSettings?

  @@map("users")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Appearance
  theme           String  @default("light") // light, dark, auto
  language        String  @default("vi")
  timezone        String  @default("Asia/Ho_Chi_Minh")
  dateFormat      String  @default("DD/MM/YYYY")
  compactMode     Boolean @default(false)
  showGridLines   Boolean @default(true)

  // Notifications
  emailNotifications    Boolean @default(true)
  deviceAlerts          Boolean @default(true)
  systemUpdates         Boolean @default(true)
  projectActivity       Boolean @default(true)
  weeklyReports         Boolean @default(false)

  // Advanced
  defaultProjectId String?
  dashboardLayout  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Role {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  permissions Json
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  userRoles   UserRoleMapping[]

  @@map("roles")
}

model UserRoleMapping {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ================================
// ORGANIZATIONAL HIERARCHY
// ================================

model Project {
  id           String        @id @default(uuid())
  name         String
  description  String?
  settings     Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sites        Site[]
  userProjects UserProject[]
  auditLogs    AuditLog[]
  scadaViews   ScadaView[]

  @@unique([tenantId, name])
  @@map("projects")
}

model UserProject {
  userId    String
  projectId String
  role      String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("user_projects")
}

model Site {
  id          String   @id @default(uuid())
  name        String
  description String?
  address     String?
  coordinates Json?
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  areas       Area[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("sites")
}

model Area {
  id          String      @id @default(uuid())
  name        String
  description String?
  metadata    Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  siteId      String
  site        Site        @relation(fields: [siteId], references: [id])
  devices     Device[]
  scadaViews  ScadaView[]

  @@unique([siteId, name])
  @@index([siteId])
  @@map("areas")
}

// ================================
// DEVICE MANAGEMENT
// ================================

model DeviceType {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  category        String
  metadata        Json?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  devices         Device[]
  deviceTemplates DeviceTemplate[]

  @@map("device_types")
}

model Device {
  id           String       @id @default(uuid())
  name         String
  description  String?
  tbDeviceId   String       @unique
  tbEntityId   String?
  serialNumber String?
  model        String?
  firmware     String?
  metadata     Json?
  isActive     Boolean      @default(true)
  isOnline     Boolean      @default(false)
  lastSeen     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  areaId       String
  deviceTypeId String
  area         Area         @relation(fields: [areaId], references: [id])
  deviceType   DeviceType   @relation(fields: [deviceTypeId], references: [id])
  deviceState  DeviceState?
  scadaOverride DeviceScadaOverride?
  auditLogs    AuditLog[]

  @@unique([areaId, name])
  @@index([areaId])
  @@index([deviceTypeId])
  @@index([createdAt(sort: Desc)])
  @@index([isActive, areaId])
  @@map("devices")
}

model DeviceTemplate {
  id           String     @id @default(uuid())
  name         String
  description  String?
  template     Json
  preview      String?
  version      String     @default("1.0.0")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deviceTypeId String
  deviceType   DeviceType @relation(fields: [deviceTypeId], references: [id])

  @@unique([deviceTypeId, name])
  @@map("device_templates")
}

model DeviceState {
  id            String   @id @default(uuid())
  telemetryData Json?
  attributes    Json?
  alarms        Json?
  lastUpdate    DateTime @default(now())
  deviceId      String   @unique
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_states")
}

// ================================
// SCADA SYSTEM
// ================================

// Device-level SCADA: Templates per device profile
model DeviceScadaTemplate {
  id                String   @id @default(uuid())
  name              String
  description       String?
  screenDefinition  Json     // ScreenDefinition JSON with $currentDevice placeholders
  thumbnail         String?
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  profileDefaults DeviceProfileScadaDefault[]
  overrides       DeviceScadaOverride[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("device_scada_templates")
}

// Tracks which TB device profiles belong to which eitek tenant
model TenantDeviceProfile {
  id              String   @id @default(uuid())
  tbProfileId     String   // ThingsBoard device profile ID
  tenantId        String
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tbProfileId])
  @@index([tbProfileId])
  @@map("tenant_device_profiles")
}

// Tracks which TB asset profiles belong to which eitek tenant
model TenantAssetProfile {
  id              String   @id @default(uuid())
  tbProfileId     String   // ThingsBoard asset profile ID
  tenantId        String
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tbProfileId])
  @@index([tbProfileId])
  @@map("tenant_asset_profiles")
}

// Mapping: one default SCADA template per (tenant, device profile)
model DeviceProfileScadaDefault {
  id              String   @id @default(uuid())
  deviceProfileId String   // ThingsBoard device profile ID
  templateId      String
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template DeviceScadaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, deviceProfileId])
  @@index([templateId])
  @@map("device_profile_scada_defaults")
}

// Per-device overrides on top of the profile's default template
model DeviceScadaOverride {
  id         String   @id @default(uuid())
  deviceId   String
  templateId String
  overrides  Json     // Partial widget overrides: { widgets: { [id]: { properties, visible, ... } } }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  device   Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  template DeviceScadaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([deviceId])
  @@index([templateId])
  @@map("device_scada_overrides")
}

model ScadaView {
  id           String        @id @default(uuid())
  name         String
  description  String?
  icon         String?
  layout       Json
  background   String?
  canvasSize   Json
  settings     Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  areaId       String?
  area         Area?         @relation(fields: [areaId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  scadaWidgets ScadaWidget[]

  @@map("scada_views")
}

model ScadaWidget {
  id          String    @id @default(uuid())
  position    Json
  properties  Json
  bindings    Json
  actions     Json      @default("[]")
  styles      Json?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scadaViewId String
  widgetId    String
  scadaView   ScadaView @relation(fields: [scadaViewId], references: [id], onDelete: Cascade)
  widget      Widget    @relation(fields: [widgetId], references: [id])

  @@map("scada_widgets")
}

// ================================
// WIDGET SYSTEM
// ================================

model WidgetCategory {
  id          String           @id @default(uuid())
  name        String
  description String?
  icon        String?
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)  // true = system category (created by Super Admin)
  tenantId    String?          // null = system category, visible to all tenants
  parentId    String?
  parent      WidgetCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    WidgetCategory[] @relation("CategoryTree")
  widgets     Widget[]

  @@unique([name, parentId, tenantId])
  @@index([tenantId])
  @@map("widget_categories")
}

model Widget {
  id           String          @id @default(uuid())
  name         String
  description  String?
  type         String
  config       Json
  template     Json
  preview      String?
  version      String          @default("1.0.0")
  isActive     Boolean         @default(true)
  isSystem     Boolean         @default(false)  // true = system widget (created by Super Admin)
  tenantId     String?         // null = system widget, visible to all tenants
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  categoryId   String?
  symbolId     String?
  category     WidgetCategory? @relation(fields: [categoryId], references: [id])
  symbol       Symbol?         @relation(fields: [symbolId], references: [id])
  scadaWidgets ScadaWidget[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([isSystem])
  @@map("widgets")
}

model Symbol {
  id          String   @id @default(uuid())
  name        String
  description String?
  svg         String
  metadata    Json?
  tags        String[]
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)  // true = system symbol (created by Super Admin)
  tenantId    String?  // null = system symbol, visible to all tenants
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  widgets     Widget[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("symbols")
}

model WidgetTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  template    Json
  preview     String?
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("widget_templates")
}

// ================================
// FILE MANAGEMENT
// ================================

model ImageCategory {
  id          String           @id @default(uuid())
  name        String
  description String?
  icon        String?
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)  // true = system category (created by Super Admin)
  tenantId    String?          // null = system category, visible to all tenants
  parentId    String?
  parent      ImageCategory?   @relation("ImageCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ImageCategory[]  @relation("ImageCategoryTree")
  files       File[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, parentId, tenantId])
  @@index([tenantId])
  @@map("image_categories")
}

model File {
  id              String          @id @default(uuid())
  filename        String
  originalName    String
  mimetype        String
  size            Int
  type            FileType
  path            String
  url             String?
  metadata        Json?
  isPublic        Boolean         @default(false)
  isSystem        Boolean         @default(false)  // true = system resource (uploaded by Super Admin)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  uploadedBy      String
  uploader        User            @relation("FileUploader", fields: [uploadedBy], references: [id])
  tenantId        String?         // null = system resource, visible to all tenants
  imageCategoryId String?
  imageCategory   ImageCategory?  @relation(fields: [imageCategoryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([type])
  @@index([isSystem])
  @@map("files")
}

// ================================
// AUDIT & LOGGING
// ================================

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  metadata  Json?
  timestamp DateTime    @default(now())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id])
  deviceId  String?
  device    Device?     @relation(fields: [deviceId], references: [id])

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([entityId])
  @@index([deviceId])
  @@map("audit_logs")
}

// ================================
// NOTIFICATIONS
// ================================

enum NotificationType {
  DEVICE_OFFLINE
  DEVICE_ONLINE
  DEVICE_ALARM
  SYSTEM_UPDATE
  SYSTEM_MAINTENANCE
  ADMIN_MESSAGE
  ACCOUNT_ACTIVITY
  PROJECT_UPDATE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Notification {
  id        String               @id @default(uuid())
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String
  data      Json?                // Extra payload (deviceId, link, etc.)
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  // Target
  userId    String               // Recipient
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ================================
// SYSTEM SETTINGS (Super Admin)
// ================================

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   // general, thingsboard, email, branding, security
  label     String?
  description String?
  isSecret  Boolean  @default(false) // true = mask value in API response
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}
