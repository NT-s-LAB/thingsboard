# ================================
# FRONTEND ENV VARIABLES TEMPLATE
# Copy file này thành .env.local (dev) hoặc .env.production (VPS)
# File này được commit lên git để tham khảo cấu trúc
# ================================

# ---------- FRONTEND PORT ----------
# Port Next.js dev/start server chạy trên
PORT=3000

# ---------- BACKEND API ----------
# URL của NestJS backend
# Dev:  http://localhost:3001
# Prod: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001

# ---------- WEBSOCKET ----------
# Dùng cùng URL với API (ws:// cho http, wss:// cho https)
# Dev:  ws://localhost:3001
# Prod: https://api.yourdomain.com  (socket.io tự chuyển sang wss)
WEBSOCKET_URL=ws://localhost:3001

# ---------- THINGSBOARD ----------
# URL của ThingsBoard server
NEXT_PUBLIC_THINGSBOARD_API_URL=http://platform.eitek.vn
