{
  "$schema": "../widget.schema.json",
  "_description": "Full multi-page SCADA project with button, gauge, label, switch, and card",
  "id": "project_demo",
  "schemaVersion": 2,
  "name": "Demo SCADA Project",
  "description": "Example project demonstrating binding, event, and action parity",
  "homePageId": "page_main",
  "pages": [
    {
      "id": "page_main",
      "name": "Main Dashboard",
      "pageType": "normal",
      "canvasSize": { "width": 1920, "height": 1080 },
      "background": { "type": "color", "color": "#f8fafc" },
      "layers": [
        { "id": "layer_main", "name": "Main", "visible": true, "locked": false, "opacity": 1, "order": 0 }
      ],
      "widgets": [
        {
          "id": "gauge_temp",
          "type": "gauge",
          "name": "Temperature",
          "layerId": "layer_main",
          "transform": {
            "position": { "x": 50, "y": 50 },
            "size": { "width": 250, "height": 250 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "variant": "radial",
            "title": "Temperature",
            "min": 0,
            "max": 100,
            "unit": "°C",
            "showTitle": true,
            "showValue": true,
            "showUnit": true,
            "thresholdEnabled": true,
            "thresholds": [
              { "value": 0, "color": "#22C55E" },
              { "value": 60, "color": "#F59E0B" },
              { "value": 80, "color": "#EF4444" }
            ]
          },
          "bindings": [
            {
              "id": "b1",
              "targetProperty": "value",
              "source": {
                "type": "telemetry",
                "entityType": "DEVICE",
                "entityId": "device-001",
                "key": "temperature"
              },
              "format": { "type": "number", "decimals": 1 },
              "defaultValue": 0
            }
          ],
          "events": [
            {
              "id": "e1",
              "trigger": "onClick",
              "enabled": true,
              "actions": [
                { "id": "a1", "type": "openPopup", "popupPageId": "page_temp_detail" }
              ]
            }
          ],
          "actions": []
        },
        {
          "id": "label_temp",
          "type": "text",
          "name": "Temp Label",
          "layerId": "layer_main",
          "transform": {
            "position": { "x": 350, "y": 100 },
            "size": { "width": 200, "height": 40 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "text": "--",
            "fontSize": 24,
            "fontWeight": "bold",
            "color": "#374151",
            "alignment": "center"
          },
          "bindings": [
            {
              "id": "b2",
              "targetProperty": "text",
              "source": {
                "type": "telemetry",
                "entityType": "DEVICE",
                "entityId": "device-001",
                "key": "temperature"
              },
              "format": {
                "type": "number",
                "decimals": 1,
                "unit": "°C"
              },
              "defaultValue": "N/A"
            },
            {
              "id": "b3",
              "targetProperty": "color",
              "source": {
                "type": "telemetry",
                "entityType": "DEVICE",
                "entityId": "device-001",
                "key": "temperature"
              },
              "format": {
                "type": "string",
                "valueMap": {}
              },
              "defaultValue": "#374151"
            }
          ],
          "events": [],
          "actions": []
        },
        {
          "id": "switch_pump",
          "type": "switch",
          "name": "Pump Switch",
          "layerId": "layer_main",
          "transform": {
            "position": { "x": 50, "y": 350 },
            "size": { "width": 200, "height": 60 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "label": "Pump Control",
            "showLabel": true,
            "onColor": "#22C55E",
            "offColor": "#9CA3AF"
          },
          "bindings": [
            {
              "id": "b4",
              "targetProperty": "state",
              "source": {
                "type": "telemetry",
                "entityType": "DEVICE",
                "entityId": "device-001",
                "key": "pumpState"
              },
              "defaultValue": false
            }
          ],
          "events": [
            {
              "id": "e2",
              "trigger": "onValueChange",
              "enabled": true,
              "actions": [
                {
                  "id": "a2",
                  "type": "rpcCall",
                  "deviceId": "device-001",
                  "rpcMethod": "setPumpState",
                  "rpcParams": {},
                  "rpcOneWay": true
                },
                {
                  "id": "a3",
                  "type": "showNotification",
                  "message": "Pump state changed",
                  "level": "info",
                  "durationMs": 2000
                }
              ]
            }
          ],
          "actions": []
        },
        {
          "id": "btn_details",
          "type": "button",
          "name": "View Details",
          "layerId": "layer_main",
          "transform": {
            "position": { "x": 50, "y": 450 },
            "size": { "width": 160, "height": 44 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "text": "Details",
            "icon": "settings",
            "buttonColor": "#6366F1",
            "textColor": "#FFFFFF",
            "borderRadius": 8
          },
          "bindings": [],
          "events": [
            {
              "id": "e3",
              "trigger": "onClick",
              "enabled": true,
              "actions": [
                { "id": "a4", "type": "navigateToPage", "targetPageId": "page_details" }
              ]
            }
          ],
          "actions": []
        }
      ],
      "variables": [
        { "id": "var1", "name": "selectedDevice", "type": "string", "defaultValue": "device-001" }
      ],
      "events": [],
      "order": 0,
      "createdAt": "2026-03-16T00:00:00Z",
      "updatedAt": "2026-03-16T00:00:00Z"
    },
    {
      "id": "page_details",
      "name": "Device Details",
      "pageType": "normal",
      "canvasSize": { "width": 1920, "height": 1080 },
      "background": { "type": "color", "color": "#f1f5f9" },
      "layers": [
        { "id": "layer_detail", "name": "Main", "visible": true, "locked": false, "opacity": 1, "order": 0 }
      ],
      "widgets": [
        {
          "id": "btn_back",
          "type": "button",
          "name": "Back",
          "layerId": "layer_detail",
          "transform": {
            "position": { "x": 20, "y": 20 },
            "size": { "width": 100, "height": 40 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "text": "← Back",
            "buttonColor": "#64748B",
            "textColor": "#FFFFFF",
            "borderRadius": 6
          },
          "bindings": [],
          "events": [
            {
              "id": "e4",
              "trigger": "onClick",
              "enabled": true,
              "actions": [
                { "id": "a5", "type": "goBack" }
              ]
            }
          ],
          "actions": []
        }
      ],
      "variables": [],
      "events": [],
      "order": 1,
      "createdAt": "2026-03-16T00:00:00Z",
      "updatedAt": "2026-03-16T00:00:00Z"
    },
    {
      "id": "page_temp_detail",
      "name": "Temperature Detail",
      "pageType": "popup",
      "canvasSize": { "width": 400, "height": 300 },
      "background": { "type": "color", "color": "#ffffff" },
      "layers": [
        { "id": "layer_popup", "name": "Main", "visible": true, "locked": false, "opacity": 1, "order": 0 }
      ],
      "widgets": [
        {
          "id": "gauge_temp_big",
          "type": "gauge",
          "name": "Temperature Detail",
          "layerId": "layer_popup",
          "transform": {
            "position": { "x": 100, "y": 20 },
            "size": { "width": 200, "height": 200 },
            "rotation": 0,
            "zIndex": 1
          },
          "properties": {
            "variant": "semicircle",
            "title": "Temperature",
            "min": 0,
            "max": 100,
            "unit": "°C"
          },
          "bindings": [
            {
              "id": "b5",
              "targetProperty": "value",
              "source": {
                "type": "telemetry",
                "entityType": "DEVICE",
                "entityId": "device-001",
                "key": "temperature"
              },
              "defaultValue": 0
            }
          ],
          "events": [],
          "actions": []
        },
        {
          "id": "btn_close_popup",
          "type": "button",
          "name": "Close",
          "layerId": "layer_popup",
          "transform": {
            "position": { "x": 150, "y": 240 },
            "size": { "width": 100, "height": 36 },
            "rotation": 0,
            "zIndex": 2
          },
          "properties": {
            "text": "Close",
            "buttonColor": "#EF4444",
            "textColor": "#FFFFFF",
            "borderRadius": 6
          },
          "bindings": [],
          "events": [
            {
              "id": "e5",
              "trigger": "onClick",
              "enabled": true,
              "actions": [
                { "id": "a6", "type": "closePopup" }
              ]
            }
          ],
          "actions": []
        }
      ],
      "variables": [],
      "events": [],
      "order": 2,
      "popupSettings": {
        "closeOnBackdropClick": true,
        "showTitleBar": true,
        "title": "Temperature Detail"
      },
      "createdAt": "2026-03-16T00:00:00Z",
      "updatedAt": "2026-03-16T00:00:00Z"
    }
  ],
  "globalVariables": [],
  "metadata": {
    "createdAt": "2026-03-16T00:00:00Z",
    "updatedAt": "2026-03-16T00:00:00Z",
    "createdBy": "admin",
    "tags": ["demo"],
    "version": 1
  },
  "settings": {
    "defaultCanvasSize": { "width": 1920, "height": 1080 },
    "defaultBackground": { "type": "color", "color": "#f8fafc" },
    "transition": "fade"
  }
}
