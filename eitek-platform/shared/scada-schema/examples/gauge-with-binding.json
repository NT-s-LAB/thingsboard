{
  "$schema": "../widget.schema.json",
  "_description": "Gauge bound to temperature telemetry with threshold colors",
  "id": "gauge_temp",
  "type": "gauge",
  "name": "Temperature Gauge",
  "layerId": "layer_main",
  "transform": {
    "position": { "x": 50, "y": 50 },
    "size": { "width": 200, "height": 200 },
    "rotation": 0,
    "zIndex": 5
  },
  "properties": {
    "variant": "radial",
    "title": "Temperature",
    "min": 0,
    "max": 100,
    "unit": "°C",
    "precision": 1,
    "showTitle": true,
    "showValue": true,
    "showUnit": true,
    "showMinMax": true,
    "showNeedle": true,
    "thickness": 12,
    "startAngle": 135,
    "endAngle": 405,
    "trackColor": "#E5E7EB",
    "fillColor": "#3B82F6",
    "needleColor": "#374151",
    "textColor": "#374151",
    "titleColor": "#6B7280",
    "thresholdEnabled": true,
    "thresholds": [
      { "value": 0, "color": "#22C55E", "label": "Normal" },
      { "value": 60, "color": "#F59E0B", "label": "Warning" },
      { "value": 80, "color": "#EF4444", "label": "Critical" }
    ]
  },
  "bindings": [
    {
      "id": "bind_gauge_value",
      "targetProperty": "value",
      "source": {
        "type": "telemetry",
        "entityType": "DEVICE",
        "entityId": "device-sensor-001",
        "key": "temperature"
      },
      "format": {
        "type": "number",
        "decimals": 1
      },
      "defaultValue": 0
    }
  ],
  "events": [
    {
      "id": "evt_gauge_click",
      "trigger": "onClick",
      "enabled": true,
      "actions": [
        {
          "id": "act_open_detail",
          "type": "openPopup",
          "popupPageId": "page_temp_detail"
        }
      ]
    }
  ],
  "actions": [],
  "visible": true,
  "locked": false
}
